# 실제 값은 .env.local (커밋 금지). Vercel 환경변수에 동일 키 설정.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # 서버 only — lib/supabase/admin.ts 만 사용
NEXT_PUBLIC_SITE_URL=https://www.ghpc.or.kr
NEXT_PUBLIC_KAKAO_MAP_KEY=           # 카카오 개발자 콘솔 JavaScript 키 (공개 키) — 플랫폼 > Web 사이트 도메인에 localhost·vercel·ghpc.or.kr 등록
SENTRY_DSN=
